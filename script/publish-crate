#!/usr/bin/env bash

# Publishes the crate named by the argument to crates.io with trusted publishing, exchanging the GitHub Actions OIDC
# token for a short-lived crates.io token. crates.io matches the `release.yml` caller workflow, not the reusable workflow.

set -euo pipefail

crate=$1

# crates.io rejects requests with curl's default User-Agent.
user_agent='willbooster-tree-sitter-release (https://github.com/WillBooster/tree-sitter)'

jwt=$(curl -sSf --retry 3 -H "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
  "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=crates.io" | jq -r .value)
token=$(curl -sSf --retry 3 -A "$user_agent" -X POST https://crates.io/api/v1/trusted_publishing/tokens \
  -H 'Content-Type: application/json' -d "{\"jwt\":\"$jwt\"}" | jq -r .token)
# Revocation is best-effort (the token expires on its own); its failure must not fail an already-done publish.
trap 'curl -sSf -A "$user_agent" -X DELETE -H "Authorization: Bearer $token" https://crates.io/api/v1/trusted_publishing/tokens ||
  echo "warning: failed to revoke the crates.io token"' EXIT

# The release versions written by script/set-version are not committed.
CARGO_REGISTRY_TOKEN=$token cargo publish -p "$crate" --allow-dirty
