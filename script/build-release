#!/usr/bin/env bash

# Keep this build complete for the artifacts listed in lib/binding_web/package.json.

set -euo pipefail

cd "$(dirname "$0")/.."
script/set-version "$1"
cd lib/binding_web
npm ci
npm run build
npm run build:debug
CJS=true npm run build
CJS=true npm run build:debug
npm run build:dts
