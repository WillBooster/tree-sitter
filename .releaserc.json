{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "script/set-version ${nextRelease.version} && cd lib/binding_web && npm ci && npm run build"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "lib/binding_web"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failCommentCondition": false,
        "labels": ["r: semantic-release"],
        "releasedLabels": ["released :bookmark:"]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "script/publish-crate"
      }
    ]
  ]
}
