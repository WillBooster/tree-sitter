{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "script/build-release ${nextRelease.version}"
      }
    ],
    [
      "./script/releasePlugin.mjs",
      {
        "crate": "willbooster-tree-sitter",
        "pkgRoot": "lib/binding_web"
      }
    ]
  ]
}
