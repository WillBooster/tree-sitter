{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // The web package's node module resolution and type-aware linting fail with TypeScript 6.
      "matchFileNames": ["lib/binding_web/package.json"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.0.0",
    },
    {
      // These are templates of the files that `tree-sitter init` writes into a grammar repository, not manifests of
      // this repository, so the preset's pinning and updates would ship in every generated grammar. `ignorePaths` is
      // not used because Renovate does not merge it: a value here would replace the inherited list that keeps the
      // manifests under test/ and tests/ away from the preset's pinning.
      "matchFileNames": ["crates/cli/src/templates/**"],
      "enabled": false,
    },
    {
      // The runtime dependencies of the published @willbooster/web-tree-sitter are installed by its consumers, so the
      // preset's exact pins would force one version on them and duplicate packages that they also depend on.
      // `replace` keeps the range and rewrites it only for a version outside it, as Renovate's
      // `:pinOnlyDevDependencies` preset does for libraries; the devDependencies stay pinned by the preset.
      "matchFileNames": ["lib/binding_web/package.json"],
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "replace",
    },
  ],
}
